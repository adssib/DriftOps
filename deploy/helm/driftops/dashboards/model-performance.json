     "rawQuery": true,
     "editorMode": "code",
     "format": "time_series",
     "rawSql": "SELECT window_end AS time, (metrics->>'observed_rate')::float AS \"observed\" FROM monitor_results WHERE run_id = $run AND monitor = 'perf' AND $__timeFilter(window_end) ORDER BY 1"
    },
