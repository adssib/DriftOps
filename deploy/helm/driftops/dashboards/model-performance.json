     "rawSql": "SELECT s.key AS carrier, (s.value->>'rows')::int AS flights, round((s.value->>'brier')::numeric, 4) AS brier, round((s.value->>'calibration_gap')::numeric, 4) AS calibration_gap FROM monitor_results, jsonb_each(metrics->'slices') AS s WHERE run_id = $run AND monitor = 'perf' AND window_end = (SELECT max(window_end) FROM monitor_results WHERE run_id = $run AND monitor = 'perf') ORDER BY flights DESC"
