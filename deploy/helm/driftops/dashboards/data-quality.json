      "type": "grafana-postgresql-datasource",
      "uid": "driftops-postgres"
     },
     "rawQuery": true,
     "editorMode": "code",
     "format": "time_series",
     "rawSql": "SELECT window_end AS time, (metrics->>'null_increase')::float AS \"null_increase\" FROM monitor_results WHERE run_id = $run AND monitor = 'quality' AND $__timeFilter(window_end) ORDER BY 1"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
