  {
   "type": "timeseries",
   "title": "null increase",
   "description": "Worst rise in a column's null rate vs. training. The 'lookup times out' corruption.",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "driftops-postgres"
   },
   "targets": [
    {
     "refId": "A",
