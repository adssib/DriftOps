   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "driftops-postgres"
     },
     "rawQuery": true,
     "editorMode": "code",
     "format": "time_series",
     "rawSql": "SELECT window_end AS time, alarm::int AS \"drift\" FROM monitor_results WHERE run_id = $run AND monitor = 'drift' AND $__timeFilter(window_end) ORDER BY 1"
