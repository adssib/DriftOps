      "spanNulls": true,
      "thresholdsStyle": {
       "mode": "dashed"
      }
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 0.1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "gridPos": {
    "x": 12,
    "y": 2,
    "w": 12,
    "h": 9
   },
   "id": 3
  },
  {
   "type": "timeseries",
   "title": "Prediction PSI (charted, not alarmed)",
   "description": "Score distribution vs. reference. Swings with the seasons even when nothing is wrong.",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "driftops-postgres"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "driftops-postgres"
     },
     "rawQuery": true,
     "editorMode": "code",
     "format": "time_series",
     "rawSql": "SELECT window_end AS time, (metrics->>'psi_score')::float AS \"prediction PSI\" FROM monitor_results WHERE run_id = $run AND monitor = 'drift' AND $__timeFilter(window_end) ORDER BY 1"
    }
   ],
   "fieldConfig": {
